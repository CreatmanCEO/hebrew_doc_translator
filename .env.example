# Server
NODE_ENV=development
PORT=3001

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis (queue + cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LiteLLM proxy (OpenAI-compatible protocol; routes to Claude/Gemini — NO OpenAI)
LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=
TRANSLATE_MODEL=translate

# AI providers (consumed by the LiteLLM proxy)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Limits / DoS caps
MAX_FILE_MB=25
MAX_PAGES=50
MAX_DOCX_UNCOMPRESSED_MB=100
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=900000
DOWNLOAD_TTL_MS=900000
